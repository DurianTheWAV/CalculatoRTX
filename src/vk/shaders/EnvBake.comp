// CalculatoRTX - génère l'environnement HDR en projection latitude-longitude (backend Vulkan).
#version 460
#extension GL_GOOGLE_include_directive : require

#include "Env.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba32f) uniform writeonly image2D outEnv;

void main()
{
    const ivec2 size = imageSize(outEnv);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    const float u = (float(p.x) + 0.5) / float(size.x), v = (float(p.y) + 0.5) / float(size.y);
    const float phi = (u - 0.5) * 6.28318530717958647692, theta = v * 3.14159265358979323846;
    const vec3 d = vec3(sin(theta) * sin(phi), cos(theta), -sin(theta) * cos(phi));
    imageStore(outEnv, p, vec4(studio(d), 1.0));
}
